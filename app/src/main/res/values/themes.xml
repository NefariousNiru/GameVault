<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GameVault" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.GameVault.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#080B13</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/gv_splash_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.GameVault</item>
    </style>
</resources>
